diff --git a/src/apu/apu_xaudio2.c b/src/apu/apu_xaudio2.c
index e139d2e..cbbdc01 100644
--- a/src/apu/apu_xaudio2.c
+++ b/src/apu/apu_xaudio2.c
@@ -366,13 +366,143 @@ void xa2_get_output_stats(Xa2OutputStats *stats)
     }
 }
 
-#else /* !_WIN32 -- POSIX stubs (no audio output yet) */
-
-int  xa2_init(void)                                   { return 0; }
-void xa2_shutdown(void)                               {}
-int  xa2_is_active(void)                              { return 0; }
-int  xa2_submit_samples(const int16_t *s, int n)      { (void)s; (void)n; return 0; }
-int  xa2_get_buffer_size(void)                        { return 0; }
-void xa2_get_output_stats(Xa2OutputStats *s)           { memset(s, 0, sizeof(*s)); }
+#else /* !_WIN32 -- SDL2 audio output, same contract as the XAudio2 graph */
+
+/* Mirrored semantics: 48 kHz stereo s16, three 1024-frame packets, playback
+ * starts once two packets are queued (and re-primes the same way after an
+ * underrun), a full queue is BACKPRESSURE rather than a dropped packet, and
+ * the stats block reports submitted/played in per-channel samples. */
+#include <SDL.h>
+
+#define XA2_SAMPLE_RATE   48000
+#define XA2_CHANNELS      2
+#define XA2_BUF_SAMPLES   1024
+#define XA2_NUM_BUFS      3
+
+static SDL_AudioDeviceID g_sdl_audio;
+static SDL_AudioStream  *g_sdl_stream;   /* only when the device format differs */
+static int               g_sdl_started;
+static uint64_t          g_sdl_submitted; /* per-channel samples accepted */
+static Xa2OutputStats    g_sdl_stats;
+
+int xa2_init(void)
+{
+    SDL_AudioSpec want, have;
+
+    if (g_sdl_audio)
+        return 1;
+    if (SDL_InitSubSystem(SDL_INIT_AUDIO) < 0) {
+        fprintf(stderr, "[AUDIO] SDL audio init failed: %s\n", SDL_GetError());
+        return 0;
+    }
+    memset(&want, 0, sizeof(want));
+    want.freq = XA2_SAMPLE_RATE;
+    want.format = AUDIO_S16LSB;
+    want.channels = XA2_CHANNELS;
+    want.samples = XA2_BUF_SAMPLES;
+    g_sdl_audio = SDL_OpenAudioDevice(NULL, 0, &want, &have,
+                                      SDL_AUDIO_ALLOW_FREQUENCY_CHANGE |
+                                      SDL_AUDIO_ALLOW_FORMAT_CHANGE);
+    if (!g_sdl_audio) {
+        fprintf(stderr, "[AUDIO] no output device: %s\n", SDL_GetError());
+        return 0;
+    }
+    if (have.freq != want.freq || have.format != want.format ||
+        have.channels != want.channels) {
+        g_sdl_stream = SDL_NewAudioStream(want.format, want.channels, want.freq,
+                                          have.format, have.channels, have.freq);
+        if (!g_sdl_stream) {
+            fprintf(stderr, "[AUDIO] stream create failed: %s\n", SDL_GetError());
+            SDL_CloseAudioDevice(g_sdl_audio);
+            g_sdl_audio = 0;
+            return 0;
+        }
+    }
+    memset(&g_sdl_stats, 0, sizeof(g_sdl_stats));
+    g_sdl_submitted = 0;
+    g_sdl_started = 0;
+    fprintf(stderr, "[AUDIO] SDL output %d Hz %s (%d x %d-sample buffers)\n",
+            have.freq, g_sdl_stream ? "with conversion" : "direct",
+            XA2_NUM_BUFS, XA2_BUF_SAMPLES);
+    return 1;
+}
+
+void xa2_shutdown(void)
+{
+    if (g_sdl_stream) { SDL_FreeAudioStream(g_sdl_stream); g_sdl_stream = NULL; }
+    if (g_sdl_audio) { SDL_CloseAudioDevice(g_sdl_audio); g_sdl_audio = 0; }
+    g_sdl_started = 0;
+}
+
+int xa2_is_active(void) { return g_sdl_audio != 0; }
+
+static uint32_t sdl_queued_frames(void)
+{
+    Uint32 bytes = SDL_GetQueuedAudioSize(g_sdl_audio);
+    if (g_sdl_stream)
+        bytes += (Uint32)SDL_AudioStreamAvailable(g_sdl_stream);
+    return bytes / (XA2_CHANNELS * sizeof(int16_t));
+}
+
+int xa2_submit_samples(const int16_t *samples, int num_samples)
+{
+    int copy_samples;
+
+    if (!g_sdl_audio || !samples || num_samples <= 0)
+        return XA2_SUBMIT_ERROR;
+    copy_samples = num_samples > XA2_BUF_SAMPLES ? XA2_BUF_SAMPLES : num_samples;
+
+    if (!g_sdl_started && sdl_queued_frames() == 0 && g_sdl_submitted) {
+        /* Underrun: the queue drained dry; re-prime before restarting. */
+        ++g_sdl_stats.reprimes;
+    }
+    if (sdl_queued_frames() >= (uint32_t)(XA2_NUM_BUFS * XA2_BUF_SAMPLES)) {
+        ++g_sdl_stats.queue_full;
+        return XA2_SUBMIT_BACKPRESSURE;
+    }
+    if (g_sdl_stream) {
+        if (SDL_AudioStreamPut(g_sdl_stream, samples,
+                copy_samples * XA2_CHANNELS * (int)sizeof(int16_t)) < 0 ||
+            SDL_AudioStreamFlush(g_sdl_stream) < 0) {
+            ++g_sdl_stats.submit_failed;
+            return XA2_SUBMIT_ERROR;
+        }
+        for (;;) {
+            uint8_t buf[XA2_BUF_SAMPLES * XA2_CHANNELS * sizeof(int16_t) * 2];
+            int got = SDL_AudioStreamGet(g_sdl_stream, buf, (int)sizeof(buf));
+            if (got < 0) { ++g_sdl_stats.submit_failed; return XA2_SUBMIT_ERROR; }
+            if (got == 0) break;
+            if (SDL_QueueAudio(g_sdl_audio, buf, (Uint32)got) < 0) {
+                ++g_sdl_stats.submit_failed;
+                return XA2_SUBMIT_ERROR;
+            }
+        }
+    } else if (SDL_QueueAudio(g_sdl_audio, samples,
+                 (Uint32)(copy_samples * XA2_CHANNELS * sizeof(int16_t))) < 0) {
+        ++g_sdl_stats.submit_failed;
+        return XA2_SUBMIT_ERROR;
+    }
+    g_sdl_submitted += (uint64_t)copy_samples;
+    g_sdl_stats.submitted_samples += (uint64_t)copy_samples;
+    /* Prime two packets before starting, like the XAudio2 path. */
+    if (!g_sdl_started &&
+        sdl_queued_frames() >= (uint32_t)(2 * XA2_BUF_SAMPLES)) {
+        SDL_PauseAudioDevice(g_sdl_audio, 0);
+        g_sdl_started = 1;
+    }
+    return XA2_SUBMIT_ACCEPTED;
+}
+
+int xa2_get_buffer_size(void) { return XA2_BUF_SAMPLES; }
+
+void xa2_get_output_stats(Xa2OutputStats *stats)
+{
+    uint32_t queued = g_sdl_audio ? sdl_queued_frames() : 0;
+    *stats = g_sdl_stats;
+    stats->queued_buffers = queued / XA2_BUF_SAMPLES;
+    stats->played_samples = g_sdl_submitted > queued ? g_sdl_submitted - queued : 0;
+    if (g_sdl_audio && !g_sdl_started && queued == 0 && g_sdl_submitted)
+        stats->empty_queue = 1;
+}
 
 #endif /* _WIN32 */

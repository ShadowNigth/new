diff --git a/src/kernel/thread_placement.c b/src/kernel/thread_placement.c
index 5532be8..b7aa387 100644
--- a/src/kernel/thread_placement.c
+++ b/src/kernel/thread_placement.c
@@ -15,11 +15,70 @@
  * hardware threads stay in the mask, so the thread may move between them but nothing else is put on that core on
  * purpose), and the polling roles take the efficiency cores.
  */
+#if defined(_WIN32)
 #include <windows.h>
+#elif defined(__linux__)
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <sched.h>
+#endif
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
+#if defined(__linux__)
+/* Linux: explicit RECOMP_PIN_<ROLE>=<hex mask> pins through
+ * sched_setaffinity (bit i = logical CPU i, up to 1024 CPUs). Automatic
+ * hybrid placement has no portable efficiency-class source here, so
+ * automatic mode leaves placement to the scheduler; explicit masks -- the
+ * override that exists for debugging -- work exactly as on Windows. */
+void xbox_PinThread(const char *role)
+{
+    char name[48];
+    const char *e;
+    static int s_mode = -1;
+    cpu_set_t set;
+    int cpu;
+
+    if (s_mode < 0) {
+        const char *m = getenv("RECOMP_THREAD_PLACEMENT");
+        s_mode = !(m && *m == '0');
+    }
+    if (!s_mode || !role)
+        return;
+    snprintf(name, sizeof(name), "RECOMP_PIN_%s", role);
+    e = getenv(name);
+    if (!e || !*e)
+        return;
+    CPU_ZERO(&set);
+    {
+        /* Parse from the least significant hex digit: digit k covers
+         * CPUs 4k..4k+3, which keeps masks wider than 64 CPUs usable. */
+        size_t len = strlen(e), i;
+        if (len > 2 && e[0] == '0' && (e[1] == 'x' || e[1] == 'X')) { e += 2; len -= 2; }
+        for (i = 0; i < len; i++) {
+            char c = e[len - 1 - i];
+            unsigned v = (c >= '0' && c <= '9') ? (unsigned)(c - '0')
+                       : (c >= 'a' && c <= 'f') ? (unsigned)(c - 'a' + 10)
+                       : (c >= 'A' && c <= 'F') ? (unsigned)(c - 'A' + 10) : 0;
+            int bit;
+            for (bit = 0; bit < 4; bit++)
+                if (v & (1u << bit)) {
+                    size_t which = i * 4 + (size_t)bit;
+                    if (which < CPU_SETSIZE) CPU_SET(which, &set);
+                }
+        }
+    }
+    for (cpu = 0; cpu < CPU_SETSIZE; cpu++)
+        if (CPU_ISSET(cpu, &set))
+            break;
+    if (cpu == CPU_SETSIZE)
+        return;
+    if (pthread_setaffinity_np(pthread_self(), sizeof(set), &set) == 0)
+        fprintf(stderr, "[THREAD] %s pinned by %s\n", role, name);
+}
+#else
+
 typedef struct PCore { KAFFINITY mask; BYTE eff; } PCore;
 
 static PCore s_core[128];
@@ -119,3 +178,4 @@ void xbox_PinThread(const char *role)
         }
     }
 }
+#endif /* _WIN32 / __linux__ */

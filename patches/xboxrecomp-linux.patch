+static DWORD veh_exception_code(int sig, siginfo_t *info)
+{
+    switch (sig) {
+    case SIGSEGV: case SIGBUS: return EXCEPTION_ACCESS_VIOLATION;
+    case SIGILL:  return EXCEPTION_ILLEGAL_INSTRUCTION;
+    case SIGTRAP: return EXCEPTION_SINGLE_STEP;
+    case SIGFPE:
+        switch (info ? info->si_code : 0) {
+        case FPE_INTDIV: return EXCEPTION_INT_DIVIDE_BY_ZERO;
+        case FPE_INTOVF: return 0xC0000095u; /* EXCEPTION_INT_OVERFLOW */
+        case FPE_FLTDIV: return EXCEPTION_FLT_DIVIDE_BY_ZERO;
+        case FPE_FLTUND: return EXCEPTION_FLT_UNDERFLOW;
+        case FPE_FLTOVF: return EXCEPTION_FLT_OVERFLOW;
+        case FPE_FLTRES: return EXCEPTION_FLT_INEXACT_RESULT;
+        default:         return EXCEPTION_FLT_INVALID_OPERATION;
+        }
+    default: return EXCEPTION_ACCESS_VIOLATION;
+    }
+}
+
+static void veh_context_from_ucontext(const ucontext_t *uc, CONTEXT *ctx)
+{
+    const greg_t *g = uc->uc_mcontext.gregs;
+    memset(ctx, 0, sizeof(*ctx));
+    ctx->Rax = (uint64_t)g[REG_RAX]; ctx->Rcx = (uint64_t)g[REG_RCX];
+    ctx->Rdx = (uint64_t)g[REG_RDX]; ctx->Rbx = (uint64_t)g[REG_RBX];
+    ctx->Rsp = (uint64_t)g[REG_RSP]; ctx->Rbp = (uint64_t)g[REG_RBP];
+    ctx->Rsi = (uint64_t)g[REG_RSI]; ctx->Rdi = (uint64_t)g[REG_RDI];
+    ctx->R8  = (uint64_t)g[REG_R8];  ctx->R9  = (uint64_t)g[REG_R9];
+    ctx->R10 = (uint64_t)g[REG_R10]; ctx->R11 = (uint64_t)g[REG_R11];
+    ctx->R12 = (uint64_t)g[REG_R12]; ctx->R13 = (uint64_t)g[REG_R13];
+    ctx->R14 = (uint64_t)g[REG_R14]; ctx->R15 = (uint64_t)g[REG_R15];
+    ctx->Rip = (uint64_t)g[REG_RIP];
+    ctx->EFlags = (uint32_t)g[REG_EFL];
+    ctx->SegCs = (uint16_t)(g[REG_CSGSFS] & 0xFFFF);
+    if (uc->uc_mcontext.fpregs)
+        ctx->MxCsr = (DWORD)uc->uc_mcontext.fpregs->mxcsr;

+/* ---- Vectored exception handling over POSIX signals ---------------------
+ * The recompiled game traps guest MMIO (APU/NV2A registers live in pages the
+ * memory layout leaves unmapped) and diagnoses crashes through Win32 VEH.
+ * This maps the hardware signals onto the same contract: build an
+ * EXCEPTION_RECORD + CONTEXT from the ucontext, run the registered handlers
+ * (First handlers before the rest, each group in registration order), and
+ * when one returns EXCEPTION_CONTINUE_EXECUTION write the context back --
+ * the MMIO decoders advance Rip past the faulting instruction -- and resume.
+ * If nobody handles it, restore the default disposition and return, so the
+ * faulting instruction re-executes and the process dies by the real signal.
+ * Handlers run on the faulting thread with the signal blocked; a handler
+ * that itself faults recurses once and then hits the default action. */
+#if defined(__x86_64__) && defined(__linux__)
+#include <ucontext.h>
+
+#define VEH_MAX_HANDLERS 16
+typedef struct VehEntry {
+    PVECTORED_EXCEPTION_HANDLER handler;
+    ULONG first;

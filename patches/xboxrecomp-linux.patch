+/*
+ * windows.h - POSIX shim, found only on the Linux include path.
+ *
+ * src/platform/CMakeLists.txt puts this directory on the include path only
+ * for the non-Windows `platform` target (on Windows that target is an
+ * INTERFACE library exposing just src/), so a real Windows SDK header of
+ * the same name always wins there and this file is Linux-only in practice.
+ * The explicit _WIN32 guard below keeps that true even if the directory
+ * ever leaks into a Windows include path.
+ *
+ * Runtime code written against <windows.h> (the Kelvin renderer, the PC
+ * input/video layers) compiles unchanged against the POSIX implementation
+ * of the same primitives in win32_compat.h.
+ */
+#ifndef PLATFORM_WINDOWS_SHIM_H
+#define PLATFORM_WINDOWS_SHIM_H
+
+#if !defined(_WIN32)
+
+#include "win32_compat.h"
+
+/* MSVC spellings that survive in the renderer sources. */
+#ifndef __int64
+#define __int64 long long
+#endif
+#ifndef __forceinline
+#define __forceinline inline __attribute__((always_inline))
+#endif
+
+#endif /* !_WIN32 */
+#endif /* PLATFORM_WINDOWS_SHIM_H */

diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index e63d153..6a07bc3 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -62,6 +62,15 @@ LONG InterlockedCompareExchange(volatile LONG *p, LONG xchg, LONG cmp)
     return cmp;
 }
 
+LONGLONG InterlockedIncrement64(volatile LONGLONG *p)        { return __atomic_add_fetch(p, 1, __ATOMIC_SEQ_CST); }
+LONGLONG InterlockedDecrement64(volatile LONGLONG *p)        { return __atomic_sub_fetch(p, 1, __ATOMIC_SEQ_CST); }

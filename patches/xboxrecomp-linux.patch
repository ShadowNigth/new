+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) < 0) {
+        fprintf(stderr, "[FBWIN] SDL video init failed: %s\n", SDL_GetError());
+        exit(1);
+    }
+    window = SDL_CreateWindow("BLACK",
+        SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
+        (int)(s_policy.width ? s_policy.width : 1280),
+        (int)(s_policy.height ? s_policy.height : 960),
+        SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE |
+        (s_policy.borderless ? SDL_WINDOW_BORDERLESS : 0));
+    if (!window) {
+        fprintf(stderr, "[FBWIN] window creation failed: %s\n", SDL_GetError());
+        exit(1);
+    }
+    renderer = SDL_CreateRenderer(window, -1,
+        (s_policy.vsync ? SDL_RENDERER_PRESENTVSYNC : 0) | SDL_RENDERER_ACCELERATED);
+    if (!renderer)
+        renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_SOFTWARE);
+    if (!renderer) {
+        fprintf(stderr, "[FBWIN] renderer creation failed: %s\n", SDL_GetError());
+        exit(1);
+    }
+    fprintf(stderr, "[FBWIN] SDL presenter: %ux%u scale %u vsync %u\n",
+            s_policy.width, s_policy.height, s_policy.scale, s_policy.vsync);
+    if (s_policy.borderless)
+        SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+
+    for (;;) {
+        SDL_Event ev;
+        FbFrame *frame = NULL;
+        int want_capture;
+
+        while (SDL_PollEvent(&ev)) {
+            switch (ev.type) {
+            case SDL_QUIT:
+                pc_input_focus_event(0);
+                s_state = FB_CLOSED;
+                fprintf(stderr, "[FBWIN] window closed\n");
+                exit(0); /* as on Windows: closing the window ends the game */
+            case SDL_KEYDOWN: case SDL_KEYUP: {
+                unsigned code; int ext;
+                if (ev.type == SDL_KEYDOWN && ev.key.keysym.scancode == SDL_SCANCODE_F11 &&
+                    !ev.key.repeat) {
+                    if (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN_DESKTOP)
+                        SDL_SetWindowFullscreen(window, 0);
+                    else
+                        SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+                    break;
+                }
+                if (fb_sdl_to_set1(ev.key.keysym.scancode, &code, &ext))
+                    pc_input_key_event(code, ext, ev.type == SDL_KEYDOWN,
+                                       ev.key.repeat != 0);
+                break;
+            }
+            case SDL_MOUSEBUTTONDOWN: case SDL_MOUSEBUTTONUP: {
+                int button = ev.button.button == SDL_BUTTON_LEFT ? 0 :
+                             ev.button.button == SDL_BUTTON_RIGHT ? 1 :
+                             ev.button.button == SDL_BUTTON_MIDDLE ? 2 :
+                             ev.button.button == SDL_BUTTON_X1 ? 3 : 4;
+                pc_input_mouse_button_event(button, ev.type == SDL_MOUSEBUTTONDOWN);
+                break;
+            }
+            case SDL_MOUSEWHEEL:
+                pc_input_wheel_event((int)(ev.wheel.y * 120));
+                break;
+            case SDL_MOUSEMOTION:
+                if (captured)
+                    pc_input_mouse_motion(ev.motion.xrel, ev.motion.yrel);
+                break;
+            case SDL_WINDOWEVENT:
+                if (ev.window.event == SDL_WINDOWEVENT_FOCUS_GAINED) {
+                    focused = 1; pc_input_focus_event(1);
+                } else if (ev.window.event == SDL_WINDOWEVENT_FOCUS_LOST ||
+                           ev.window.event == SDL_WINDOWEVENT_MINIMIZED) {
+                    focused = 0; pc_input_focus_event(0);
+                }
+                break;
+            default:
+                break;
+            }
+        }
+
+        want_capture = focused && pc_input_capture_wanted();
+        if (want_capture != captured) {
+            captured = want_capture;
+            SDL_SetRelativeMouseMode(captured ? SDL_TRUE : SDL_FALSE);
+            pc_input_capture_changed(captured);
+        }
+
+        pthread_mutex_lock(&s_frames_lock);
+        if (s_close_requested) {
+            pthread_mutex_unlock(&s_frames_lock);
+            pc_input_focus_event(0);
+            exit(0);
+        }
+        if (s_pending) {
+            FbFrame *old = s_displayed;
+            s_displayed = s_pending; s_pending = NULL;
+            frame = s_displayed;
+            pthread_mutex_unlock(&s_frames_lock);
+            free(old);
+        } else {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            ts.tv_nsec += 8 * 1000 * 1000;
+            if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+            pthread_cond_timedwait(&s_frame_ready, &s_frames_lock, &ts);
+            pthread_mutex_unlock(&s_frames_lock);
+        }
+        if (!frame)
+            continue;
+
+        {
+            uint64_t now_ms = SDL_GetTicks64();
+            if (s_policy.fps_limit) {
+                uint64_t interval = 1000 / s_policy.fps_limit;
+                if (now_ms - last_present_ms < interval)
+                    continue;
+                last_present_ms = now_ms;
+            }
+        }
+        if (!texture || tex_w != frame->width || tex_h != frame->height) {
+            if (texture) SDL_DestroyTexture(texture);
+            texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888,
+                                        SDL_TEXTUREACCESS_STREAMING,
+                                        (int)frame->width, (int)frame->height);
+            if (!texture)
+                continue;
+            tex_w = frame->width; tex_h = frame->height;
+            SDL_SetTextureScaleMode(texture,
+                s_policy.nearest ? SDL_ScaleModeNearest : SDL_ScaleModeLinear);
+        }
+        if (SDL_UpdateTexture(texture, NULL, frame->pixels,
+                              (int)(frame->width * 4)) < 0)
+            continue;
+        {
+            int cw, ch;
+            FbPresentRect r;
+            SDL_Rect dst;
+            SDL_GetRendererOutputSize(renderer, &cw, &ch);
+            r = fb_present_rect((unsigned)cw, (unsigned)ch, frame->width, frame->height,
+                frame->aspect_w ? FB_SCALE_FIT : s_policy.scale, s_policy.nearest,
+                frame->aspect_w ? frame->aspect_w : s_policy.aspect_w,
+                frame->aspect_h ? frame->aspect_h : s_policy.aspect_h);
+            SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+            SDL_RenderClear(renderer);
+            dst.x = (int)r.x; dst.y = (int)r.y;
+            dst.w = (int)r.width; dst.h = (int)r.height;
+            if (dst.w > 0 && dst.h > 0)
+                SDL_RenderCopy(renderer, texture, NULL, &dst);
+            SDL_RenderPresent(renderer);
+            presented++;
+            if (s_dump && presented == 60)
+                xbox_FramebufferDumpBmp(s_dump);
+        }
+    }
+    return NULL;
+}
+
+void xbox_FramebufferWindowStart(void)
+{
+    pthread_t thread;
+    pthread_once(&s_once, fb_initialize);
+    if (!s_enabled)
+        return;
+    if (__sync_lock_test_and_set(&s_state, FB_RUNNING) != FB_NOT_STARTED)
+        return;
+    if (pthread_create(&thread, NULL, fb_present_thread, NULL) != 0) {
+        fprintf(stderr, "[FBWIN] presentation thread creation failed\n");
+        s_state = FB_CLOSED;
+        exit(1);
+    }
+    pthread_detach(thread);
+}
 #endif

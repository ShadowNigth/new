+
+static void veh_context_to_ucontext(const CONTEXT *ctx, ucontext_t *uc)
+{
+    greg_t *g = uc->uc_mcontext.gregs;
+    g[REG_RAX] = (greg_t)ctx->Rax; g[REG_RCX] = (greg_t)ctx->Rcx;
+    g[REG_RDX] = (greg_t)ctx->Rdx; g[REG_RBX] = (greg_t)ctx->Rbx;
+    g[REG_RSP] = (greg_t)ctx->Rsp; g[REG_RBP] = (greg_t)ctx->Rbp;
+    g[REG_RSI] = (greg_t)ctx->Rsi; g[REG_RDI] = (greg_t)ctx->Rdi;
+    g[REG_R8]  = (greg_t)ctx->R8;  g[REG_R9]  = (greg_t)ctx->R9;
+    g[REG_R10] = (greg_t)ctx->R10; g[REG_R11] = (greg_t)ctx->R11;
+    g[REG_R12] = (greg_t)ctx->R12; g[REG_R13] = (greg_t)ctx->R13;
+    g[REG_R14] = (greg_t)ctx->R14; g[REG_R15] = (greg_t)ctx->R15;
+    g[REG_RIP] = (greg_t)ctx->Rip;
+    g[REG_EFL] = (greg_t)ctx->EFlags;
+    if (uc->uc_mcontext.fpregs)
+        uc->uc_mcontext.fpregs->mxcsr = (uint16_t)(ctx->MxCsr & 0xFFFF);
+}
+
+static void veh_signal_handler(int sig, siginfo_t *info, void *uctx)
+{
+    ucontext_t *uc = (ucontext_t *)uctx;
+    CONTEXT ctx;
+    EXCEPTION_RECORD record;
+    EXCEPTION_POINTERS pointers;
+    int i, pass;
+
+    veh_context_from_ucontext(uc, &ctx);
+    memset(&record, 0, sizeof(record));
+    record.ExceptionCode = veh_exception_code(sig, info);
+    record.ExceptionAddress = (PVOID)(uintptr_t)ctx.Rip;
+    if (record.ExceptionCode == EXCEPTION_ACCESS_VIOLATION) {
+        record.NumberParameters = 2;
+        /* x86 page-fault error code: bit 1 set = the access was a write. */
+        record.ExceptionInformation[0] =
+            (uc->uc_mcontext.gregs[REG_ERR] & 0x2) ? 1 : 0;
+        record.ExceptionInformation[1] =
+            (ULONG_PTR)(uintptr_t)(info ? info->si_addr : NULL);
+    }
+    pointers.ExceptionRecord = &record;
+    pointers.ContextRecord = &ctx;
+
+    for (pass = 0; pass < 2; pass++) {
+        for (i = 0; i < s_veh_count; i++) {
+            LONG result;
+            if ((pass == 0) != (s_veh[i].first != 0))
+                continue;
+            result = s_veh[i].handler(&pointers);
+            if (result == EXCEPTION_CONTINUE_EXECUTION) {
+                veh_context_to_ucontext(&ctx, uc);
+                return;
+            }
+            if (result == EXCEPTION_EXECUTE_HANDLER)
+                break;
+        }
+    }
+    /* Unhandled: die by the real signal, not by re-entering this handler. */
+    signal(sig, SIG_DFL);
+}
+
+static void veh_install_locked(void)
+{
+    static const int kSignals[] = { SIGSEGV, SIGBUS, SIGFPE, SIGILL, SIGTRAP };
+    struct sigaction sa;
+    size_t i;
+    if (s_veh_installed)
+        return;
+    s_veh_installed = 1;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = veh_signal_handler;
+    sa.sa_flags = SA_SIGINFO;
+    sigemptyset(&sa.sa_mask);
+    for (i = 0; i < sizeof(kSignals) / sizeof(kSignals[0]); i++)
+        sigaction(kSignals[i], &sa, NULL);
+}
+
 PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
-{ (void)First; (void)Handler; return NULL; }   /* TODO: wire to sigaction */
+{
+    int slot;
+    if (!Handler || s_veh_count >= VEH_MAX_HANDLERS)
+        return NULL;
+    veh_install_locked();
+    slot = s_veh_count++;
+    s_veh[slot].handler = Handler;
+    s_veh[slot].first = First;
+    /* The entry itself is the opaque handle, as on Windows. */
+    return (PVOID)&s_veh[slot];
+}
+
+ULONG RemoveVectoredExceptionHandler(PVOID Handle)
+{
+    int i;
+    for (i = 0; i < s_veh_count; i++) {
+        if ((PVOID)&s_veh[i] == Handle) {
+            s_veh[i].handler = NULL;
+            return 1;
+        }
+    }
+    return 0;
+}
+#else
+PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
+{ (void)First; (void)Handler; return NULL; }
